# Relaxes an fcc supercell to zero pressure (lattice parameter and cohesive energy of fcc Ni).
# in : potential_file, data_file (fcc supercell), out_file
# out: variables lx [Å] (relaxed box length) and Ecoh [eV/atom]; the relaxed cell is written to out_file

variable        potential_file index potential.mod
variable        data_file      index work/a0.data
variable        out_file       index work/a0_out.data

units           metal
atom_style      atomic
boundary        p p p
read_data       ${data_file}
include         ${potential_file}
fix             1 all box/relax iso 0.0 vmax 0.001
minimize        0 1e-12 5000 50000
variable        lx   equal lx
variable        Ecoh equal pe/atoms
write_data      ${out_file}
